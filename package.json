{
  "name": "nintenthropic",
  "private": true,
  "version": "0.3.0",
  "description": "Nintenthropic: games you play with your hands in the browser, four finger-gun shooters and a kart racer for up to four.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "party": "vite --mode party --host",
    "play": "vite --port 5191 --strictPort --open /race.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "lean-qr": "^2.7.4",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.157.0"
  }
}
